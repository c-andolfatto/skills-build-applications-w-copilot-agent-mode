# OctoFit Tracker – frontend environment variables
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and never committed.

# Required: your GitHub Codespace name (the subdomain before -8000.app.github.dev).
# The app builds the API base URL as:
#   https://${VITE_CODESPACE_NAME}-8000.app.github.dev
# When this variable is unset the app falls back to http://localhost:8000.
VITE_CODESPACE_NAME=your-codespace-name-here
